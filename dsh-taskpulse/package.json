{
  "name": "dsh-taskpulse",
  "version": "1.0.0",
  "description": "DSH TaskPulse —— 在 DSH 右上角实时展示当前正在执行的任务（多工作区 / 多会话 / 多 Agent 状态监控中心）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "cordis.yml",
    "icon.svg",
    "docs",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node scripts/run-all-tests.mjs",
    "test:models": "node test/models.test.mjs",
    "test:drag": "node test/drag.test.mjs",
    "test:panel": "node test/panel.test.mjs",
    "test:store": "node test/store.test.mjs",
    "test:taskflow": "node test/taskflow.test.mjs",
    "test:components": "node test/components.test.mjs",
    "test:bundle": "node test/bundle.test.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "taskpulse",
    "task-monitor",
    "agent-task"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2 <0.3.0",
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0"
  }
}
